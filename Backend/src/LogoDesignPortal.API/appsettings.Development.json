{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200",
      "http://localhost",
      "http://localhost:80",
      "http://localhost:83",
      "http://localhost:8080",
      "http://127.0.0.1",
      "http://127.0.0.1:80",
      "http://127.0.0.1:8080"
    ]
  },
  "ConnectionStrings": {
    "_comment": "Set real credentials via: dotnet user-secrets set ConnectionStrings:DefaultConnection \"...\"",
    "DefaultConnection": "Server=127.0.0.1;Port=3306;Database=LogoDesignPortalDb;User=root;Password=REPLACE_IN_USER_SECRETS_OR_ENV;"
  },
  "Scalability": {
    "AllowInMemoryFallback": true
  },
  "FileStorage": {
    "Path": "Files_Dev"
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "BasePath": "Files_Dev"
    }
  },
  "Email": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "FromEmail": "",
    "FromName": "Hawk Merchandising Web Portal",
    "FrontendUrl": "http://localhost:4200"
  },
  "Jwt": {
    "_comment": "Jwt:Key is empty in appsettings.json — required via dotnet user-secrets set Jwt:Key (≥32 chars). See docs/ENVIRONMENT_VARIABLE_REFERENCE.md.",
    "PreviousKey": "",
    "KeyVersion": "v1"
  }
}
