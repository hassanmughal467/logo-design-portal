<?xml version="1.0" encoding="utf-8"?>
<!--
  Staging IIS template — copy to web.config on the staging API site and set values via IIS Manager
  or deployment automation. Do NOT commit real secrets to source control.
  See docs/STAGING_SETUP_GUIDE.md and docs/ENVIRONMENT_VARIABLE_REFERENCE.md
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="524288000" />
        </requestFiltering>
      </security>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\LogoDesignPortal.API.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Staging" />
          <!-- Required: set real values in IIS or secret manager -->
          <environmentVariable name="ConnectionStrings__DefaultConnection" value="REPLACE_AT_DEPLOY_TIME" />
          <environmentVariable name="ConnectionStrings__Redis" value="REPLACE_AT_DEPLOY_TIME" />
          <environmentVariable name="Jwt__Key" value="REPLACE_AT_DEPLOY_TIME" />
        </environmentVariables>
      </aspNetCore>
      <webSocket enabled="true" />
    </system.webServer>
  </location>
</configuration>
