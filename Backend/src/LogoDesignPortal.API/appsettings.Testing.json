{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=integration_test.db"
  },
  "Jwt": {
    "Key": "IntegrationTestJwtKeyMustBeAtLeast32CharactersLong!",
    "Issuer": "LogoDesignPortal",
    "Audience": "LogoDesignPortalUsers",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryHours": 24
  },
  "FileStorage": {
    "Path": "Files_Test",
    "OrphanCleanupIntervalMinutes": 1440
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "BasePath": "Files_Test"
    }
  },
  "AuthCookies": {
    "Enabled": true,
    "Secure": false,
    "SameSite": "Lax"
  },
  "ProductionSafety": {
    "DisableBillingGeneration": false,
    "DisableDesignerPayout": false,
    "DisableFileUploads": false,
    "DisableInvoiceEditing": false
  }
}
