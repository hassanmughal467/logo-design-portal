{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "LogoDesignPortal.API"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200",
      "http://127.0.0.1:4200",
      "https://127.0.0.1:4200"
    ]
  },
  "ConnectionStrings": {
    "_comment": "Override per environment via appsettings.{Environment}.json or env vars (ConnectionStrings__DefaultConnection, ConnectionStrings__Redis).",
    "DefaultConnection": "Server=127.0.0.1;Port=3306;Database=LogoDesignPortalDb;User=root;Password=REPLACE_IN_USER_SECRETS_OR_ENV;",
    "_redis_comment": "Required for Staging/Production. Example: ConnectionStrings__Redis=localhost:6379,abortConnect=false"
  },
  "Redis": {
    "_comment": "Alternative to ConnectionStrings:Redis — set Redis__Configuration in IIS/env."
  },
  "Database": {
    "RunAfterStartup": true,
    "StartDelaySeconds": 2
  },
  "Scalability": {
    "AllowInMemoryFallback": false
  },
  "RateLimiting": {
    "GeneralPerMinute": 60,
    "AuthPerMinute": 5,
    "OrdersMutationsPerMinute": 120,
    "FileUploadPerMinute": 30
  },
  "AuthCookies": {
    "Enabled": true,
    "AccessTokenCookieName": "ldp_access",
    "RefreshTokenCookieName": "ldp_refresh",
    "CsrfCookieName": "ldp_csrf",
    "CsrfHeaderName": "X-XSRF-TOKEN",
    "Path": "/",
    "Secure": true,
    "SameSite": "None"
  },
  "Jwt": {
    "_comment": "Override via User Secrets (Development) or Jwt__Key env var (Staging/Production). Never commit real keys.",
    "Key": "CHANGE_ME_USE_USER_SECRETS_OR_ENV_JWT_KEY_MIN_32_CHARS",
    "Issuer": "LogoDesignPortal",
    "Audience": "LogoDesignPortalUsers",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryHours": 168
  },
  "FileStorage": {
    "Path": "Files",
    "OrphanCleanupIntervalMinutes": 1440
  },
  "InvoiceBranding": {
    "LogoPath": ""
  },
  "Observability": {
    "Enabled": false,
    "ServiceName": "LogoDesignPortal.API",
    "OtlpEndpoint": "",
    "ApplicationInsightsConnectionString": ""
  },
  "HealthChecks": {
    "Memory": {
      "DegradedWorkingSetMb": 1024,
      "UnhealthyWorkingSetMb": 2048
    }
  },
  "Email": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "FromEmail": "",
    "FromName": "Hawk Merchandising Web Portal",
    "FrontendUrl": "http://localhost:4200",
    "_comment": "Leave SMTP empty for dev (reset links on screen). Set via Email__* env vars in deployed environments."
  }
}
