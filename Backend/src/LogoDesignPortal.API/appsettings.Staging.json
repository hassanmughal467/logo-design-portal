{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IncludeExceptionDetailsInProduction": false,
  "AllowedHosts": "staging-admin.hawkmerchandising.com;staging-api.hawkmerchandising.com",
  "Database": {
    "RunAfterStartup": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://staging-admin.hawkmerchandising.com",
      "https://staging-api.hawkmerchandising.com"
    ]
  },
  "Scalability": {
    "AllowInMemoryFallback": false,
    "RedisRetryCount": 3,
    "RedisRetryBaseDelayMs": 500,
    "RedisConnectTimeout": 5000,
    "EmergencyFallbackEnabled": false
  },
  "ConnectionStrings": {
    "_comment": "Set ConnectionStrings__DefaultConnection and ConnectionStrings__Redis via IIS env or secret manager.",
    "DefaultConnection": "REPLACE_IN_ENV_ConnectionStrings__DefaultConnection"
  },
  "Jwt": {
    "_comment": "Set Jwt__Key and Jwt__PreviousKey via environment — do not commit staging signing keys.",
    "PreviousKey": "",
    "KeyVersion": "v1",
    "Issuer": "LogoDesignPortal",
    "Audience": "LogoDesignPortalUsers",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryHours": 168
  },
  "FileStorage": {
    "Path": "Files_Staging"
  },
  "Storage": {
    "Provider": "R2",
    "R2": {
      "_comment": "Set Storage__R2__AccountId, Storage__R2__AccessKeyId, Storage__R2__SecretAccessKey via IIS env or secret manager.",
      "AccountId": "",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "BucketName": "hawk-files",
      "PublicDomain": ""
    },
    "Local": {
      "BasePath": "Files_Staging"
    }
  },
  "ExchangeRate": {
    "_comment": "Set ExchangeRate__ApiKey via environment or secret manager.",
    "ApiKey": "",
    "BaseCurrency": "USD",
    "TargetCurrency": "PKR",
    "CacheTtlMinutes": 60,
    "FallbackRate": 280.0
  },
  "Email": {
    "SmtpServer": "",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "FromEmail": "",
    "FromName": "Hawk Merchandising Web Portal (Staging)",
    "FrontendUrl": "https://staging-admin.hawkmerchandising.com"
  },
  "ProductionSafety": {
    "DisableBillingGeneration": true,
    "DisableDesignerPayout": true,
    "DisableFileUploads": false,
    "DisableInvoiceEditing": false
  },
  "Payments": {
    "_comment": "Use test/sandbox payment providers only in staging.",
    "UseTestMode": true
  }
}
