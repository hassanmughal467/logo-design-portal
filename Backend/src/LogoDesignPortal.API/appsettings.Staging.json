{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "_comment": "Override for IIS Staging - use env var ConnectionStrings__DefaultConnection in production",
    "DefaultConnection": "Server=localhost;Database=LogoDesignPortalDb_Staging;User=root;Password=YOUR_STAGING_PASSWORD;"
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyForJWTTokenGenerationThatShouldBeAtLeast32CharactersLong!",
    "Issuer": "LogoDesignPortal",
    "Audience": "LogoDesignPortalUsers"
  },
  "FileStorage": {
    "Path": "Files"
  },
  "ProductionSafety": {
    "DisableBillingGeneration": true,
    "DisableDesignerPayout": true,
    "DisableFileUploads": false,
    "DisableInvoiceEditing": false
  }
}
