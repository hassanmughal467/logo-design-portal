<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogoDesignPortal.Application\LogoDesignPortal.Application.csproj" />
    <ProjectReference Include="..\LogoDesignPortal.Infrastructure\LogoDesignPortal.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="8.0.1" />
    <Content Update="web.config" CopyToPublishDirectory="PreserveNewest" />
