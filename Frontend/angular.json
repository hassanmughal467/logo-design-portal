{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "logo-design-portal-frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/logo-design-portal-frontend",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "50kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "e2e": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.e2e.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "src/tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "codeCoverage": true,
            "codeCoverageExclude": [
              "**/*.module.ts",
              "**/main.ts",
              "**/environments/**",
              "**/*routing*.ts",
              "**/auth/**/*.ts",
              "**/analytics/**/*.ts",
              "**/dashboard/**/*.ts",
              "**/invoices/**/*.ts",
              "**/users/**/*.ts",
              "**/orders/**/*.ts",
              "**/financial/**/*.ts",
              "**/clients/**/*.ts",
              "**/client-pricing/**/*.ts",
              "**/client-intelligence/**/*.ts",
              "**/permissions/**/*.ts",
              "**/projects/**/*.ts",
              "**/layout/**/*.ts",
              "**/shared/models/**/*.ts",
              "**/shared/components/**/*.ts",
              "**/core/services/financial-analytics.service.ts",
              "**/core/services/realtime-notification.service.ts",
              "**/core/services/admin-analytics.service.ts",
              "**/core/services/client-churn-analytics.service.ts",
              "**/core/services/client-analytics.service.ts",
              "**/core/services/realtime-status.service.ts",
              "**/core/services/dashboard.service.ts"
            ]
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "logo-design-portal-frontend:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "logo-design-portal-frontend:build:production"
            },
            "development": {
              "browserTarget": "logo-design-portal-frontend:build:development"
            },
            "e2e": {
              "browserTarget": "logo-design-portal-frontend:build:e2e"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "4940a6c6-bce2-45e2-ab00-44543320c99a"
  }
}
