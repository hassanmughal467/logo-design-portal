# Copy to `e2e/.env` (gitignored) for local Playwright runs.
# -----------------------------------------------------------------------------
# Web + API (must match `Frontend/src/environments/environment.e2e.ts` apiUrl)
# -----------------------------------------------------------------------------
E2E_BASE_URL=http://localhost:4200
E2E_API_URL=https://localhost:44398

# -----------------------------------------------------------------------------
# Privileged operator used by auth.setup.ts → `e2e/.auth/admin.json`
# On a fresh database the API seeds: superadmin@logodesign.com / SuperAdmin@123
# -----------------------------------------------------------------------------
E2E_ADMIN_EMAIL=superadmin@logodesign.com
E2E_ADMIN_PASSWORD=SuperAdmin@123

# -----------------------------------------------------------------------------
# Optional: reuse an existing client instead of provisioning per test
# -----------------------------------------------------------------------------
#E2E_CLIENT_EMAIL=
#E2E_CLIENT_PASSWORD=

# Parallelism & retries (optional)
# PW_WORKERS=4
# E2E_RETRIES=0

# Skip Playwright auto-starting Angular when `ng serve` is already on :4200
#E2E_REUSE_SERVER=true

# After a run: npm run e2e:report  (opens e2e/playwright-report)
