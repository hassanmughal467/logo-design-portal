{
  "name": "logo-design-portal-frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:staging": "ng build --configuration=staging",
    "build:production": "ng build --configuration=production",
    "build:testing": "ng build --configuration=testing",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadlessCI",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:smoke": "playwright test e2e/tests/smoke --config=e2e/playwright.config.ts --project=mobile-chrome",
    "e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
    "e2e:elite": "playwright test --config=e2e/playwright.config.ts --project=elite-serial",
    "test:portal:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/run-pre-go-live-tests.ps1 -Tier quick",
    "test:portal:standard": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/run-pre-go-live-tests.ps1 -Tier standard -StartServers",
    "test:portal:full": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/run-pre-go-live-tests.ps1 -Tier full -StartServers",
    "test:portal:staging": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/run-pre-go-live-tests.ps1 -Tier staging",
    "mutation": "stryker run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/cdk": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@microsoft/signalr": "^10.0.0",
    "apexcharts": "^3.45.2",
    "chart.js": "^3.9.1",
    "ng-apexcharts": "~1.10.0",
    "primeicons": "^6.0.0",
    "primeng": "^17.0.0",
    "rxjs": "~7.8.1",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@playwright/test": "^1.58.2",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/jasmine-runner": "^9.6.0",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^18.0.0",
    "dotenv": "^16.6.1",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~5.2.0"
  }
}
